{
  "appId": "com.mustafaktoriyel.lexstack",
  "appName": "Lex Stack",
  "webDir": "www",
  "android": {
    "backgroundColor": "#190A0E"
  },
  "plugins": {
    "SystemBars": {
      "insetsHandling": "disable",
      "style": "DARK"
    },
